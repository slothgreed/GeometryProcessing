



layout(std430, binding = 0) buffer CameraBuffer
{
    Camera camera;
};

layout(std430,binding = 1) buffer ClusteredLightBuffer
{
   ClusteredLight[] clusteredLights;
};

layout(std430,binding = 2) buffer PointLightBuffer
{
   PointLight[] pointLights;
};

uniform sampler2D u_depthTexture;
uniform ivec2 u_windowSize;
uniform int u_lightNum;
uniform ivec3 u_clusterPartition;

shared uint minDepthBits;
shared uint maxDepthBits;
shared uint clusteredLightCount;
shared uint clusteredLightIndices[MAX_LIGHT_NUM];
shared uint hasValidDepth;

bool intersectsScreen(PointLight light, ivec2 clusterIndex, uvec2 clusterSize, float clusterMinDepth, float clusterMaxDepth)
{
    vec3 centerView = (camera.view * vec4(light.positionRadius.xyz, 1.0)).xyz;
    float radius = light.positionRadius.w;
    float lightDepth = -centerView.z;

    if (radius <= 0.0 || lightDepth + radius <= 0.0)
    {
        return false;
    }

    // XY is tested in screen space below, while Z is tested using the linear
    // view-space depth range collected from the pixels in this cluster.
    float lightMinDepth = max(lightDepth - radius, 0.0);
    float lightMaxDepth = lightDepth + radius;
    if (lightMaxDepth < clusterMinDepth || lightMinDepth > clusterMaxDepth)
    {
        return false;
    }


    vec4 centerClip = camera.proj * vec4(centerView, 1.0);
    if (centerClip.w <= 0.0)
    {
        return false;
    }

    vec2 centerNdc = centerClip.xy / centerClip.w;
    vec2 centerPixel = (centerNdc * 0.5 + 0.5) * vec2(u_windowSize);

    // Perspective-projected radius. A small inflation keeps this conservative
    // because the simple radius/depth expression slightly underestimates large,
    // close spheres.
    vec2 radiusPixel = vec2(
        abs(camera.proj[0][0]) * float(u_windowSize.x),
        abs(camera.proj[1][1]) * float(u_windowSize.y))
        * (0.5 * radius / lightDepth);
    radiusPixel *= 1.05;
    vec2 clusterPixelMin = vec2(clusterIndex * ivec2(clusterSize));
    vec2 clusterPixelMax = min(clusterPixelMin + vec2(clusterSize), vec2(u_windowSize));
    vec2 nearestPixel = clamp(centerPixel, clusterPixelMin, clusterPixelMax);
    vec2 normalizedDistance = (nearestPixel - centerPixel) / max(radiusPixel, vec2(1e-5));

    return dot(normalizedDistance, normalizedDistance) <= 1.0;
}
bool intersectsCluster(PointLight light, ivec3 clusterIndex, uvec3 clusterSize, float clusterMinDepth, float clusterMaxDepth)
{
    vec3 centerWorld = light.positionRadius.xyz;
    float radius = light.positionRadius.w;
    vec3 centerView = (camera.view * vec4(centerWorld, 1.0)).xyz;
    float lightDepth = -centerView.z;

    if (lightDepth + radius <= 0.0) { return false; }

    float lightMinDepth = max(lightDepth - radius, 0.0);
    float lightMaxDepth = lightDepth + radius;
    if (lightMaxDepth < clusterMinDepth || lightMinDepth > clusterMaxDepth)
    {
        return false;
    }

    vec2 clusterPixelMin = vec2(clusterIndex.xy * float(clusterSize.x));
    vec2 clusterPixelMax = min(clusterPixelMin + vec2(float(clusterSize.x),float(clusterSize.y)), vec2(u_windowSize));

    vec2 clusterNdcMin = clusterPixelMin / vec2(u_windowSize) * 2.0 - 1.0;
    vec2 clusterNdcMax = clusterPixelMax / vec2(u_windowSize) * 2.0 - 1.0;
    vec3 rayBottomLeft = getViewRay(camera, vec2(clusterNdcMin.x, clusterNdcMin.y));
    vec3 rayBottomRight = getViewRay(camera, vec2(clusterNdcMax.x, clusterNdcMin.y));
    vec3 rayTopLeft = getViewRay(camera, vec2(clusterNdcMin.x, clusterNdcMax.y));
    vec3 rayTopRight = getViewRay(camera, vec2(clusterNdcMax.x, clusterNdcMax.y));

    vec3 leftNormal = normalize(cross(rayBottomLeft, rayTopLeft));
    vec3 rightNormal = normalize(cross(rayTopRight, rayBottomRight));
    vec3 bottomNormal = normalize(cross(rayBottomRight,rayBottomLeft));
    vec3 topNormal = normalize(cross(rayTopLeft,rayTopRight));

    if (dot(leftNormal, centerView) < -radius) { return false; }
    if (dot(rightNormal, centerView) < -radius) { return false; }
    if (dot(bottomNormal, centerView) < -radius) { return false; }
    if (dot(topNormal, centerView) < -radius) { return false; }

    return true;
}

void main()
{
	const float MAX_DEPTH = 3.402823466e+38;
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec3 clusterIndex  = ivec3(gl_WorkGroupID);
	uint localIndex  = gl_LocalInvocationIndex;
	uvec3 clusterSize = gl_WorkGroupSize;
	uint clusterCountX = gl_NumWorkGroups.x;
	uint clusterCountY = gl_NumWorkGroups.y;
	uint clusteredLightIndex = toIndex(clusterIndex,gl_NumWorkGroups);
	
	if (localIndex == 0){
		minDepthBits = floatBitsToUint(MAX_DEPTH);
		maxDepthBits = floatBitsToUint(0.0);
	    hasValidDepth = 0;
		clusteredLightCount = 0;
	}
	if (localIndex < MAX_LIGHT_NUM){
		clusteredLightIndices[localIndex] = 0xffffffffu;
	}
	
	barrier();
	float viewDepth = 1.0;
	if (pixel.x < u_windowSize.x &&	pixel.y < u_windowSize.y)
	{
		float depth = texelFetch(u_depthTexture, pixel, 0).r;
		if(depth < 1.0){
			viewDepth = getViewDepth(camera, pixel, depth, u_windowSize);

			atomicMin(minDepthBits, floatBitsToUint(viewDepth));
			atomicMax(maxDepthBits, floatBitsToUint(viewDepth));
			atomicAdd(hasValidDepth,1);
		}
	}

	barrier();
	float minDepth = uintBitsToFloat(minDepthBits);
    float maxDepth = uintBitsToFloat(maxDepthBits);
	minDepth = getClusteredDepth(camera,u_clusterPartition.z,clusterIndex.z);
	maxDepth = getClusteredDepth(camera,u_clusterPartition.z,clusterIndex.z + 1);
	if (hasValidDepth > 0u)
	{
	uint threadCount = gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z;
	for (uint lightIndex = localIndex; lightIndex < u_lightNum; lightIndex += threadCount)
    {
		if (intersectsCluster(pointLights[lightIndex], clusterIndex, clusterSize, minDepth, maxDepth))
        {
            uint slot = atomicAdd(clusteredLightCount, 1);
			if (slot < MAX_LIGHT_NUM) {
				clusteredLightIndices[slot] = lightIndex;
			}
        }
    }
	}
    barrier();

    // save to ssbo
    if (localIndex == 0) {
		clusteredLights[clusteredLightIndex].minDepth = minDepth;;
		clusteredLights[clusteredLightIndex].maxDepth = maxDepth;;
        clusteredLights[clusteredLightIndex].debug = float(clusteredLightCount);;
		uint count = min(clusteredLightCount, MAX_LIGHT_NUM);
        clusteredLights[clusteredLightIndex].count = int(count);
        for (uint i = 0; i < count; ++i) {
            clusteredLights[clusteredLightIndex].indices[i] = int(clusteredLightIndices[i]);
        }
    }
} 

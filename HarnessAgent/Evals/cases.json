[
  {
    "id": "two-points",
    "prompt": "点数と境界ボックスを調べてください。",
    "points": [[0, 0, 0], [2, 3, 4]],
    "expected": { "ok": true, "output": { "count": 2, "min": [0, 0, 0], "max": [2, 3, 4] } }
  },
  {
    "id": "negative-coordinates",
    "prompt": "負の座標を含む点群の範囲を調べてください。",
    "points": [[-5, 2, 0], [1, -3, 4], [0, 0, -2]],
    "expected": { "ok": true, "output": { "count": 3, "min": [-5, -3, -2], "max": [1, 2, 4] } }
  },
  {
    "id": "single-point",
    "prompt": "1点だけの点群を調べてください。",
    "points": [[1, 2, 3]],
    "expected": { "ok": true, "output": { "count": 1, "min": [1, 2, 3], "max": [1, 2, 3] } }
  },
  {
    "id": "empty-input",
    "prompt": "空の点群を調べてください。",
    "points": [],
    "expected": { "ok": false, "errorContains": "non-empty array" }
  },
  {
    "id": "denied-tool",
    "prompt": "Toolを許可しない状態で点群を調べてください。",
    "points": [[0, 0, 0]],
    "allowedTools": [],
    "expected": { "ok": false, "errorContains": "tool not allowed" }
  }
]
